{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "DiceTale GM",
  "version": "0.1.0",
  "identifier": "com.dicetale.gm",
  "build": {
    "frontendDist": "../src",
    "devUrl": "http://localhost:1421",
    "beforeDevCommand": "node scripts/serve.js 1421",
    "beforeBuildCommand": "exit 0"
  },
  "app": {
    "windows": [
      {
        "title": "DiceTale GM",
        "width": 1440,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}

